{
  "name": "forgekit-reactor",
  "version": "0.1.0",
  "description": "MCP that scaffolds production-grade NX monorepos via an interactive wizard — NX + React 19 + Vite, Panda CSS + Ark UI, Storybook, and more, generated as deterministic, repeatable layers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effinrich/forgekit-reactor.git"
  },
  "homepage": "https://github.com/effinrich/forgekit-reactor#readme",
  "bugs": {
    "url": "https://github.com/effinrich/forgekit-reactor/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nx",
    "monorepo",
    "scaffold",
    "generator",
    "react",
    "cli"
  ],
  "bin": {
    "forgekit-reactor": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --max-warnings=53",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "nx": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/vitest": "23.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "nx": {}
}