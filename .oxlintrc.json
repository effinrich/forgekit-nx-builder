{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsx-a11y",
    "node",
    "promise",
    "vitest"
  ],
  // "categories": {
  //   "correctness": "error",
  //   "perf": "warn",
  //   "suspicious": "warn",
  //   "pedantic": "off",
  //   "style": "off"
  // },

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "style": "error",
    "pedantic": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true,
    "builtin": true
  },
  "rules": {
    // Off globally: 50+ hits are readFileSync/writeFileSync/mkdirSync on
    // small local files across the generators, which don't meaningfully
    // block the event loop. The real risk this rule guards against —
    // reintroducing a synchronous, multi-minute subprocess call — is
    // re-enabled just for run-command.ts below, the one file where it
    // would matter (see the override; every tool spawns subprocesses
    // exclusively through its async run() export).
    "node/no-sync": "off",
    "node/no-process-env": "off",
    "eslint/sort-keys": "off",
    "eslint/sort-imports": "off",
    "eslint/capitalized-comments": "off",
    "eslint/id-length": "off",
    "eslint/no-ternary": "off",
    "eslint/no-inline-comments": "off",
    "eslint/func-style": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/prefer-named-capture-group": "off",
    "eslint/init-declarations": "off",
    "eslint/max-params": "off",
    "eslint/max-statements": "warn",
    "eslint/no-template-curly-in-string": "off",
    "unicorn/no-null": "off",
    "unicorn/max-nested-calls": "off",
    "vitest/no-hooks": "off",
    "vitest/max-expects": "off",
    "vitest/prefer-expect-assertions": "off",
    "vitest/require-test-timeout": "off",
    "vitest/require-hook": "off",
    "typescript/explicit-function-return-type": "off",
    "no-console": "off",
    "no-unused-vars": "warn",
    "typescript/no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn",
    "react/jsx-key": "error",
    "react/no-array-index-key": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    // Node MCP/CLI: builtins (fs, path, child_process, …) are intentional.
    "import/no-nodejs-modules": "off",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
        // "checkDirectories": false,
        // "ignore": "^(AGENTS\\.md|README\\.md|CHANGELOG\\.md|LICENSE|__root\\.tsx|routeTree\\.gen\\.ts|\\d{14}_[a-f0-9-]+\\.sql)$"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/run-command.ts"],
      "rules": {
        "node/no-sync": "error"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "vitest/prefer-strict-boolean-matchers": "off",
        "vitest/prefer-to-be-truthy": "off",
        "vitest/prefer-to-be-falsy": "off",
        "vitest/prefer-strict-equal": "off",
        "vitest/prefer-importing-vitest-globals": "off",
        "vitest/no-importing-vitest-globals": "off",
        "vitest/consistent-test-it": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/expect-expect": "off",
        "vitest/no-conditional-in-test": "off",
        "eslint/max-statements": "off",
        "eslint/max-lines-per-function": "off",
        "unicorn/max-nested-calls": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".supergoal/**",
    ".omc/**",
    "dist-ssr",
    ".output",
    ".vinxi",
    ".tanstack/**",
    ".nitro",
    ".wrangler/",
    "storybook-static/**",
    "src/routeTree.gen.ts",
    "src/integrations/supabase/types.ts",
    "src/integrations/supabase/client.ts",
    "src/integrations/supabase/client.server.ts"
  ]
}
